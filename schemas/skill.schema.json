{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "inputs": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": ["name", "required", "description"],
        "additionalProperties": false
      }
    },
    "outputs": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": ["name", "description"],
        "additionalProperties": false
      }
    },
    "procedure": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 5000
      }
    },
    "safety": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "requiresModel": {
          "type": "boolean"
        },
        "requiresShell": {
          "type": "boolean"
        },
        "requiresNetwork": {
          "type": "boolean"
        }
      },
      "required": ["requiresModel", "requiresShell", "requiresNetwork"],
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "type": "number",
          "const": 1
        },
        "providers": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "any"
            }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": ["formatVersion", "providers"],
      "additionalProperties": false
    },
    "examples": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "output": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "required": ["input", "output"],
        "additionalProperties": false
      }
    },
    "acceptance": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "assets": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512,
        "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*:)(?!.*\\\\)(?!.*\\/\\/)(?!.*\\/$)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*[\\u0000-\\u001f\\u007f-\\u009f])[\\s\\S]+$"
      }
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "summary",
    "purpose",
    "inputs",
    "outputs",
    "procedure",
    "safety",
    "capabilities",
    "compatibility",
    "examples",
    "acceptance"
  ],
  "additionalProperties": false
}
